params {
    // CSV samplesheet with header "sample_id,bam" — one row per sample.
    // The .bai index is expected alongside each BAM (same path + ".bai").
    input     = "samplesheet.csv"
    // Aldy sequencer profile — common values: illumina, wgs, novaseq, exome, targeted
    sequencer = "wgs"
    genome    = "hg38"
    // Space-separated gene list; extend or override at runtime with --genes "CYP2D6 CYP2C19"
    // Run `aldy show` inside the container to list all available genes
    genes     = "CYP2D6"
    outdir    = "s3://mbyvcm/results"
}

// Verify the latest tag at: https://quay.io/repository/biocontainers/aldy?tab=tags
process.container = 'cwmed/aldy:4.8.3'

profiles {
    standard {
        singularity {
            enabled    = true
            autoMounts = true
        }
    }

    aws {
        workDir = 's3://mbyvcm/work'
        docker {
            enabled = true
        }
        process {
            executor = 'awsbatch'
            queue = 'nextflow-queue'
            cpus = 2
            memory = '4 GB'
            time = '1h'
            errorStrategy { task.attempt <= 2 ? 'retry' : 'ignore' }
        }

        aws {
            region = 'eu-west-2'
            profile = 'nextflow'
            batch {
                maxSpotAttempts = 5
            }
        }
    }
}
